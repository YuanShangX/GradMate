
.page.data-v-2aa327e7 {
	min-height: 100vh;
	background: linear-gradient(180deg, #4A90E2 0%, #FFFFFF 40%);
	padding-bottom: 40rpx;
}

/* 顶部Tab */
.top-tabs.data-v-2aa327e7 {
	display: flex;
	background-color: transparent;
	padding: 20rpx 30rpx;
	padding-top: calc(20rpx + env(safe-area-inset-top));
}
.tab-item.data-v-2aa327e7 {
	flex: 1;
	text-align: center;
	padding: 20rpx 0;
}
.tab-text.data-v-2aa327e7 {
	font-size: 32rpx;
	color: rgba(255, 255, 255, 0.7);
	font-weight: 500;
}
.tab-item.active .tab-text.data-v-2aa327e7 {
	color: #FFFFFF;
	font-weight: 600;
	border-bottom: 4rpx solid #FFFFFF;
	padding-bottom: 8rpx;
}

/* 用户信息卡片 */
.user-card.data-v-2aa327e7 {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 30rpx;
	margin: 0 30rpx 20rpx;
	background: rgba(255, 255, 255, 0.2);
	border-radius: 20rpx;
	-webkit-backdrop-filter: blur(10rpx);
	        backdrop-filter: blur(10rpx);
}
.user-info.data-v-2aa327e7 {
	display: flex;
	align-items: center;
	gap: 20rpx;
}
.user-avatar.data-v-2aa327e7 {
	width: 80rpx;
	height: 80rpx;
	border-radius: 50%;
	border: 4rpx solid #FFFFFF;
}
.user-name.data-v-2aa327e7 {
	font-size: 32rpx;
	color: #FFFFFF;
	font-weight: 600;
}
.user-badge.data-v-2aa327e7 {
	background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
	padding: 10rpx 25rpx;
	border-radius: 30rpx;
}
.badge-text.data-v-2aa327e7 {
	font-size: 24rpx;
	color: #FFFFFF;
	font-weight: 600;
}

/* 统计数据卡片 */
.stats-card.data-v-2aa327e7 {
	display: flex;
	align-items: center;
	justify-content: space-around;
	background: #FFFFFF;
	margin: 0 30rpx 30rpx;
	padding: 40rpx 20rpx;
	border-radius: 24rpx;
	box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}
.stat-item.data-v-2aa327e7 {
	text-align: center;
}
.stat-value.data-v-2aa327e7 {
	display: block;
	font-size: 48rpx;
	font-weight: bold;
	color: #333;
	margin-bottom: 10rpx;
}
.stat-label.data-v-2aa327e7 {
	font-size: 24rpx;
	color: #999;
}
.stat-divider.data-v-2aa327e7 {
	width: 2rpx;
	height: 60rpx;
	background-color: #E0E0E0;
}

/* 周期Tab */
.period-tabs.data-v-2aa327e7 {
	display: flex;
	gap: 20rpx;
	padding: 0 30rpx 20rpx;
}
.period-tab.data-v-2aa327e7 {
	padding: 15rpx 30rpx;
	font-size: 26rpx;
	color: #666;
	background-color: #F5F5F5;
	border-radius: 30rpx;
}
.period-tab.active.data-v-2aa327e7 {
	color: #FFFFFF;
	background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
	font-weight: 600;
}

/* 图表容器 */
.chart-container.data-v-2aa327e7 {
	background: #FFFFFF;
	margin: 0 30rpx 30rpx;
	padding: 30rpx;
	border-radius: 24rpx;
	box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}
.chart-wrapper.data-v-2aa327e7 {
	display: flex;
	gap: 20rpx;
}
.chart-y-axis.data-v-2aa327e7 {
	display: flex;
	flex-direction: column;
	justify-content: space-between;
	padding: 20rpx 0;
}
.y-label.data-v-2aa327e7 {
	font-size: 20rpx;
	color: #999;
}
.chart-content.data-v-2aa327e7 {
	flex: 1;
	position: relative;
	height: 400rpx;
}
.chart-grid.data-v-2aa327e7 {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 60rpx;
	display: flex;
	flex-direction: column;
	justify-content: space-between;
}
.grid-line.data-v-2aa327e7 {
	height: 1rpx;
	background-color: #F0F0F0;
}
.chart-line.data-v-2aa327e7 {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 60rpx;
}
.chart-path.data-v-2aa327e7 {
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
}
.chart-point.data-v-2aa327e7 {
	position: absolute;
	width: 16rpx;
	height: 16rpx;
	border-radius: 50%;
	transform: translate(-50%, 50%);
	box-shadow: 0 2rpx 8rpx rgba(255, 215, 0, 0.5);
}
.today-label.data-v-2aa327e7 {
	position: absolute;
	top: -40rpx;
	left: 50%;
	transform: translateX(-50%);
	background-color: #FF9500;
	color: #FFFFFF;
	font-size: 20rpx;
	padding: 6rpx 12rpx;
	border-radius: 10rpx;
	white-space: nowrap;
}
.chart-x-axis.data-v-2aa327e7 {
	position: absolute;
	bottom: 0;
	left: 0;
	right: 0;
	display: flex;
	justify-content: space-between;
	padding: 10rpx 0;
}
.x-label.data-v-2aa327e7 {
	font-size: 20rpx;
	color: #999;
}

/* 学习概览 */
.overview-section.data-v-2aa327e7 {
	background: #FFFFFF;
	margin: 0 30rpx 30rpx;
	padding: 30rpx;
	border-radius: 24rpx;
	box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}
.section-title.data-v-2aa327e7 {
	font-size: 28rpx;
	font-weight: 600;
	color: #333;
	margin-bottom: 25rpx;
	display: block;
}
.overview-grid.data-v-2aa327e7 {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 30rpx;
}
.overview-item.data-v-2aa327e7 {
	text-align: center;
}
.overview-value.data-v-2aa327e7 {
	display: block;
	font-size: 40rpx;
	font-weight: bold;
	color: #333;
	margin-bottom: 10rpx;
}
.overview-label.data-v-2aa327e7 {
	font-size: 22rpx;
	color: #999;
}

/* 学习类型分布 */
.type-section.data-v-2aa327e7 {
	background: #FFFFFF;
	margin: 0 30rpx 30rpx;
	padding: 30rpx;
	border-radius: 24rpx;
	box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
	display: flex;
	gap: 40rpx;
}
.type-chart.data-v-2aa327e7 {
	width: 200rpx;
	height: 200rpx;
}
.donut-chart.data-v-2aa327e7 {
	width: 100%;
	height: 100%;
	border-radius: 50%;
	background: conic-gradient(
		#1ABC9C 0deg 51.84deg,
		#E0E0E0 51.84deg 360deg
	);
	display: flex;
	align-items: center;
	justify-content: center;
	position: relative;
}
.donut-center.data-v-2aa327e7 {
	width: 120rpx;
	height: 120rpx;
	background: #FFFFFF;
	border-radius: 50%;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
}
.donut-label.data-v-2aa327e7 {
	font-size: 20rpx;
	color: #999;
	margin-bottom: 5rpx;
}
.donut-value.data-v-2aa327e7 {
	font-size: 28rpx;
	font-weight: bold;
	color: #333;
}
.type-legend.data-v-2aa327e7 {
	flex: 1;
	display: flex;
	flex-direction: column;
	gap: 20rpx;
}
.legend-item.data-v-2aa327e7 {
	display: flex;
	align-items: center;
	gap: 15rpx;
}
.legend-dot.data-v-2aa327e7 {
	width: 16rpx;
	height: 16rpx;
	border-radius: 50%;
}
.legend-name.data-v-2aa327e7 {
	flex: 1;
	font-size: 24rpx;
	color: #666;
}
.legend-value.data-v-2aa327e7 {
	font-size: 24rpx;
	color: #333;
	font-weight: 500;
}

/* 分享按钮 */
.share-btn-container.data-v-2aa327e7 {
	padding: 0 30rpx;
}
.share-btn.data-v-2aa327e7 {
	width: 100%;
	height: 88rpx;
	background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
	color: #FFFFFF;
	border: none;
	border-radius: 44rpx;
	font-size: 30rpx;
	font-weight: 600;
	box-shadow: 0 8rpx 20rpx rgba(74, 144, 226, 0.3);
}
.share-text.data-v-2aa327e7 {
	font-size: 28rpx;
}
