
.page.data-v-ead3e541 {
	min-height: 100vh;
	background: #006cff;
}
.status-bar.data-v-ead3e541 {
	background: #006cff;
}

/* 蓝色顶部区域 */
.header-section.data-v-ead3e541 {
	background: #006cff;
	padding: 20rpx 30rpx 80rpx;
}
.header-content.data-v-ead3e541 {
	display: flex;
	align-items: center;
	justify-content: space-between;
}
.back-btn.data-v-ead3e541 {
	width: 64rpx;
	height: 64rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	background: rgba(255, 255, 255, 0.2);
	border-radius: 32rpx;
}
.back-icon.data-v-ead3e541 {
	font-size: 48rpx;
	color: #ffffff;
	font-weight: bold;
	line-height: 1;
}
.page-title.data-v-ead3e541 {
	flex: 1;
	text-align: center;
	font-size: 36rpx;
	font-weight: 600;
	color: #ffffff;
}
.placeholder.data-v-ead3e541 {
	width: 64rpx;
}

/* 白色内容区 */
.content-section.data-v-ead3e541 {
	background: linear-gradient(180deg, #e8f3ff 0%, #f6f7fb 15%, #f6f7fb 100%);
	border-radius: 32rpx 32rpx 0 0;
	margin-top: -32rpx;
	padding: 24rpx 30rpx 40rpx;
	min-height: calc(100vh - 200rpx);
}
.form-section.data-v-ead3e541 {
	background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
	border-radius: 16rpx;
	overflow: hidden;
	box-shadow: 0 4rpx 12rpx rgba(0, 107, 255, 0.08);
	border: 1rpx solid rgba(0, 107, 255, 0.05);
	margin-bottom: 24rpx;
}
.form-item.data-v-ead3e541 {
	display: flex;
	align-items: center;
	padding: 32rpx 24rpx;
	border-bottom: 1rpx solid rgba(0, 107, 255, 0.05);
	transition: background 0.2s ease;
}
.form-item.data-v-ead3e541:active {
	background: rgba(0, 107, 255, 0.02);
}
.form-item.data-v-ead3e541:last-child {
	border-bottom: none;
}
.label.data-v-ead3e541 {
	width: 160rpx;
	font-size: 28rpx;
	color: #333;
	font-weight: 500;
}
.input.data-v-ead3e541 {
	flex: 1;
	font-size: 28rpx;
	color: #333;
}
.avatar-box.data-v-ead3e541 {
	flex: 1;
	display: flex;
	align-items: center;
	justify-content: flex-end;
}
.avatar.data-v-ead3e541 {
	width: 120rpx;
	height: 120rpx;
	border-radius: 60rpx;
	border: 4rpx solid rgba(0, 107, 255, 0.1);
	box-shadow: 0 4rpx 12rpx rgba(0, 107, 255, 0.15);
}
.btn-box.data-v-ead3e541 {
	padding: 16rpx 0;
}
.save-btn.data-v-ead3e541 {
	width: 100%;
	height: 88rpx;
	background: linear-gradient(135deg, #378cff 0%, #1b7dff 100%);
	border-radius: 44rpx;
	color: #ffffff;
	font-size: 32rpx;
	font-weight: 600;
	border: none;
	box-shadow: 0 8rpx 20rpx rgba(0, 107, 255, 0.3);
}
.save-btn.data-v-ead3e541:active {
	opacity: 0.9;
	transform: scale(0.98);
}
