}

/* 白色内容区 */
.content-section.data-v-14293891 {
	background: linear-gradient(180deg, #e8f3ff 0%, #f6f7fb 15%, #f6f7fb 100%);
	border-radius: 32rpx 32rpx 0 0;
	margin-top: -32rpx;
	padding: 24rpx 30rpx 40rpx;
	min-height: calc(100vh - 200rpx);
}

/* 步骤指示器 */
.steps.data-v-14293891 {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 32rpx 24rpx;
	background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
	border-radius: 16rpx;
	margin-bottom: 24rpx;
	box-shadow: 0 4rpx 12rpx rgba(0, 107, 255, 0.08);
	border: 1rpx solid rgba(0, 107, 255, 0.05);
}
.step.data-v-14293891 {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 8rpx;
}
.step-number.data-v-14293891 {
	width: 56rpx;
	height: 56rpx;
	border-radius: 50%;
	background: #e8e8e8;
	color: #999;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 26rpx;
	font-weight: bold;
	transition: all 0.3s ease;
}
.step.active .step-number.data-v-14293891 {
	background: linear-gradient(135deg, #378cff 0%, #1b7dff 100%);
	color: #ffffff;
	box-shadow: 0 4rpx 12rpx rgba(0, 107, 255, 0.3);
}
.step.completed .step-number.data-v-14293891 {
	background: linear-gradient(135deg, #52c990 0%, #00a870 100%);
	color: #ffffff;
}
.step-text.data-v-14293891 {
	font-size: 22rpx;
	color: #999;
}
.step.active .step-text.data-v-14293891 {
	color: #333;
	font-weight: 600;
}
.step-line.data-v-14293891 {
	flex: 1;
	height: 3rpx;
	background: #e8e8e8;
	margin: 0 16rpx;
	transition: all 0.3s ease;
}
.step-line.active.data-v-14293891 {
	background: linear-gradient(90deg, #378cff 0%, #1b7dff 100%);
}

/* 步骤内容 */
.step-content.data-v-14293891 {
	background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
	border-radius: 16rpx;
	padding: 24rpx;
	min-height: 600rpx;
	box-shadow: 0 4rpx 12rpx rgba(0, 107, 255, 0.08);
	border: 1rpx solid rgba(0, 107, 255, 0.05);
}

/* 搜索框 */
