
.page.data-v-f7870db2 {
	min-height: 100vh;
	background: #f6f7fb;
}

/* 导航栏 */
.navbar.data-v-f7870db2 {
	background: #ffffff;
	padding: 20rpx 30rpx;
	display: flex;
	align-items: center;
	position: relative;
}
.nav-back.data-v-f7870db2 {
	width: 48rpx;
	height: 48rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}
.back-icon.data-v-f7870db2 {
	font-size: 48rpx;
	color: #333;
	font-weight: bold;
}
.nav-title.data-v-f7870db2 {
	position: absolute;
	left: 50%;
	transform: translateX(-50%);
	font-size: 32rpx;
	font-weight: 600;
	color: #006bff;
}

/* 搜索栏 */
.search-bar.data-v-f7870db2 {
	background: #ffffff;
	padding: 20rpx 30rpx;
	display: flex;
	align-items: center;
	gap: 16rpx;
}
.search-box.data-v-f7870db2 {
	flex: 1;
	display: flex;
	align-items: center;
	background: #f5f5f5;
	border-radius: 50rpx;
	padding: 16rpx 24rpx;
	gap: 12rpx;
}
.search-icon.data-v-f7870db2 {
	width: 28rpx;
	height: 28rpx;
	border: 2rpx solid #999;
	border-radius: 50%;
	position: relative;
	flex-shrink: 0;
}
.search-icon.data-v-f7870db2::after {
	content: '';
	position: absolute;
	width: 2rpx;
	height: 10rpx;
	background: #999;
	transform: rotate(-45deg);
	bottom: -6rpx;
	right: -3rpx;
}
.search-input.data-v-f7870db2 {
	flex: 1;
	font-size: 28rpx;
	color: #333;
}
.clear-icon.data-v-f7870db2 {
	width: 32rpx;
	height: 32rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 36rpx;
	color: #999;
	flex-shrink: 0;
}
.search-btn.data-v-f7870db2 {
	padding: 16rpx 32rpx;
	background: #006bff;
	color: #ffffff;
	font-size: 28rpx;
	border-radius: 50rpx;
}

/* 标签页 */
.tabs.data-v-f7870db2 {
	background: #ffffff;
	display: flex;
	padding: 0 30rpx;
}
.tab-item.data-v-f7870db2 {
	flex: 1;
	padding: 24rpx 0;
	display: flex;
	flex-direction: column;
	align-items: center;
	position: relative;
}
.tab-text.data-v-f7870db2 {
	font-size: 28rpx;
	color: #666;
}
.tab-item.active .tab-text.data-v-f7870db2 {
	color: #006bff;
	font-weight: 600;
}
.tab-line.data-v-f7870db2 {
	position: absolute;
	bottom: 0;
	width: 60rpx;
	height: 4rpx;
	background: #006bff;
	border-radius: 2rpx;
}

/* 内容区 */
.content.data-v-f7870db2 {
	height: calc(100vh - 240rpx);
	padding: 24rpx 30rpx;
	box-sizing: border-box;
}

/* 资讯列表 */
.info-list.data-v-f7870db2 {
	padding-top: 20rpx;
}
.info-item.data-v-f7870db2 {
	background: #ffffff;
	border-radius: 12rpx;
	padding: 24rpx 20rpx;
	margin-bottom: 16rpx;
}
.info-header.data-v-f7870db2 {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 12rpx;
}
.info-school.data-v-f7870db2 {
	font-size: 24rpx;
	color: #006bff;
	font-weight: 500;
}
.info-date.data-v-f7870db2 {
	font-size: 22rpx;
	color: #999;
}
.info-title.data-v-f7870db2 {
	font-size: 28rpx;
	color: #333;
	line-height: 1.5;
	display: block;
}

/* 加载状态 */
.loading-text.data-v-f7870db2 {
	text-align: center;
	padding: 32rpx 0;
	font-size: 26rpx;
	color: #999;
}
.empty-text.data-v-f7870db2 {
	text-align: center;
	padding: 60rpx 0;
	font-size: 26rpx;
	color: #999;
}
.nomore-text.data-v-f7870db2 {
	text-align: center;
	padding: 32rpx 0;
	font-size: 24rpx;
	color: #ccc;
}
