
.page.data-v-bb60bfd6 {
	min-height: 100vh;
	background: #f0f3fa;
}

/* 导航栏 */
.navbar.data-v-bb60bfd6 {
	background: #ffffff;
	padding: 30rpx 30rpx;
	padding-top: calc(30rpx + env(safe-area-inset-top));
	display: flex;
	align-items: center;
	justify-content: center;
	position: relative;
	min-height: 88rpx;
	box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.nav-back.data-v-bb60bfd6 {
	position: absolute;
	left: 30rpx;
	top: 50%;
	transform: translateY(-50%);
	width: 48rpx;
	height: 48rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	z-index: 10;
}
.back-icon.data-v-bb60bfd6 {
	font-size: 56rpx;
	color: #333;
	font-weight: 300;
	line-height: 1;
}
.nav-title.data-v-bb60bfd6 {
	font-size: 36rpx;
	font-weight: 700;
	color: #333;
	text-align: center;
}

/* 内容区 */
.content.data-v-bb60bfd6 {
	height: calc(100vh - 88rpx - env(safe-area-inset-top));
	padding: 20rpx 30rpx 40rpx;
	box-sizing: border-box;
}

/* 头部卡片 */
.header-card.data-v-bb60bfd6 {
	background: linear-gradient(135deg, #e0f6ff 0%, #ffffff 100%);
	border-radius: 20rpx;
	padding: 40rpx 32rpx;
	margin-bottom: 20rpx;
	box-shadow: 0 4rpx 12rpx rgba(91, 143, 249, 0.15);
}
.school-info.data-v-bb60bfd6 {
	display: flex;
	align-items: center;
	gap: 24rpx;
	margin-bottom: 32rpx;
}
.school-logo-container.data-v-bb60bfd6 {
	width: 100rpx;
	height: 100rpx;
	border-radius: 50%;
	background: rgba(91, 143, 249, 0.15);
	display: flex;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
	overflow: hidden;
}
.school-logo.data-v-bb60bfd6 {
	width: 100%;
	height: 100%;
	border-radius: 50%;
}
.school-logo-placeholder.data-v-bb60bfd6 {
	width: 60rpx;
	height: 60rpx;
	border-radius: 50%;
	background: rgba(91, 143, 249, 0.3);
}
.school-text.data-v-bb60bfd6 {
	flex: 1;
}
.school-name.data-v-bb60bfd6 {
	font-size: 36rpx;
	font-weight: 700;
	color: #333;
	display: block;
	margin-bottom: 12rpx;
}
.major-info.data-v-bb60bfd6 {
	display: flex;
	align-items: center;
	gap: 12rpx;
}
.major-code.data-v-bb60bfd6 {
	font-size: 26rpx;
	color: #5b8ff9;
	background: rgba(91, 143, 249, 0.1);
	padding: 6rpx 16rpx;
	border-radius: 20rpx;
	font-weight: 500;
}
.major-name.data-v-bb60bfd6 {
	font-size: 28rpx;
	color: #666;
	font-weight: 500;
}

/* 收藏按钮 */
.action-button.data-v-bb60bfd6 {
	background: rgba(91, 143, 249, 0.1);
	border-radius: 16rpx;
	padding: 20rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 12rpx;
	margin-top: 24rpx;
}
.action-icon.data-v-bb60bfd6 {
	font-size: 32rpx;
	color: #5b8ff9;
}
.action-text.data-v-bb60bfd6 {
	font-size: 28rpx;
	color: #5b8ff9;
	font-weight: 500;
}

/* 信息卡片 */
.info-card.data-v-bb60bfd6 {
	background: #ffffff;
	border-radius: 20rpx;
	padding: 32rpx;
	margin-bottom: 20rpx;
	box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 研究方向标题 */
.direction-header.data-v-bb60bfd6 {
	display: flex;
	align-items: center;
	gap: 12rpx;
	margin-bottom: 32rpx;
	padding-bottom: 24rpx;
	border-bottom: 2rpx solid #f0f0f0;
}
.direction-badge.data-v-bb60bfd6 {
	width: 8rpx;
	height: 32rpx;
	background: linear-gradient(135deg, #5b8ff9 0%, #378cff 100%);
	border-radius: 4rpx;
}
.direction-title.data-v-bb60bfd6 {
	font-size: 32rpx;
	font-weight: 600;
	color: #333;
}

/* 信息区块 */
.info-section.data-v-bb60bfd6 {
	margin-bottom: 32rpx;
}
.info-section.data-v-bb60bfd6:last-child {
	margin-bottom: 0;
}
.section-title.data-v-bb60bfd6 {
	display: flex;
	align-items: center;
	gap: 12rpx;
	margin-bottom: 24rpx;
}
.title-icon.data-v-bb60bfd6 {
	width: 6rpx;
	height: 28rpx;
	background: #5b8ff9;
	border-radius: 3rpx;
}
.title-text.data-v-bb60bfd6 {
	font-size: 30rpx;
	font-weight: 600;
	color: #333;
}

/* 信息网格 */
.info-grid.data-v-bb60bfd6 {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 24rpx;
}
.info-item.data-v-bb60bfd6 {
	display: flex;
	flex-direction: column;
	gap: 8rpx;
}
.info-label.data-v-bb60bfd6 {
	font-size: 24rpx;
	color: #999;
}
.info-value.data-v-bb60bfd6 {
	font-size: 28rpx;
	color: #333;
	font-weight: 500;
}
.info-value.highlight.data-v-bb60bfd6 {
	color: #5b8ff9;
	font-weight: 600;
}

/* 考试科目 */
.subject-container.data-v-bb60bfd6 {
	display: flex;
	flex-direction: column;
	gap: 16rpx;
}
.subject-card.data-v-bb60bfd6 {
	background: #f8f9ff;
	border-radius: 12rpx;
	padding: 20rpx 24rpx;
	display: flex;
	align-items: center;
	gap: 16rpx;
	border-left: 4rpx solid #5b8ff9;
}
.subject-number.data-v-bb60bfd6 {
	font-size: 28rpx;
	color: #5b8ff9;
	font-weight: 600;
	flex-shrink: 0;
}
.subject-name.data-v-bb60bfd6 {
	font-size: 28rpx;
	color: #333;
	line-height: 1.6;
	flex: 1;
}

/* 指导教师 */
.advisor-text.data-v-bb60bfd6 {
	font-size: 28rpx;
	color: #333;
	line-height: 1.8;
	display: block;
}

/* 加载状态 */
.loading-container.data-v-bb60bfd6 {
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 120rpx 0;
}
.loading-text.data-v-bb60bfd6 {
	font-size: 28rpx;
	color: #999;
}

/* 空状态 */
.empty-container.data-v-bb60bfd6 {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 120rpx 0;
}
.empty-icon.data-v-bb60bfd6 {
	font-size: 120rpx;
	margin-bottom: 24rpx;
	opacity: 0.5;
}
.empty-text.data-v-bb60bfd6 {
	font-size: 28rpx;
	color: #999;
	margin-bottom: 12rpx;
}
.empty-hint.data-v-bb60bfd6 {
	font-size: 24rpx;
	color: #ccc;
}

/* 底部提示 */
.footer-tip.data-v-bb60bfd6 {
	padding: 40rpx 0 20rpx;
	text-align: center;
}
.tip-text.data-v-bb60bfd6 {
	font-size: 24rpx;
	color: #999;
	line-height: 1.6;
}
