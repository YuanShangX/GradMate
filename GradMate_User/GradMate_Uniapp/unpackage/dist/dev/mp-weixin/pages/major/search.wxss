
.page.data-v-dccd4508 {
	min-height: 100vh;
	background: #f0f3fa;
	display: flex;
	flex-direction: column;
}

/* 导航栏 */
.navbar.data-v-dccd4508 {
	background: #ffffff;
	padding: 20rpx 30rpx;
	padding-top: calc(20rpx + env(safe-area-inset-top));
	display: flex;
	align-items: center;
	gap: 20rpx;
	flex-shrink: 0;
}
.nav-back.data-v-dccd4508 {
	width: 48rpx;
	height: 48rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}
.back-icon.data-v-dccd4508 {
	font-size: 56rpx;
	color: #333;
	font-weight: 300;
	line-height: 1;
}
.nav-title.data-v-dccd4508 {
	flex: 1;
	text-align: center;
	font-size: 32rpx;
	font-weight: 600;
	color: #333;
	margin-right: 48rpx;
}

/* 学硕/专硕切换 */
.type-tabs.data-v-dccd4508 {
	background: #ffffff;
	padding: 20rpx 30rpx;
	display: flex;
	gap: 20rpx;
	flex-shrink: 0;
}
.type-tab.data-v-dccd4508 {
	flex: 1;
	height: 64rpx;
	border-radius: 32rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	background: #f5f5f5;
}
.type-tab.active.data-v-dccd4508 {
	background: #5b8ff9;
}
.type-tab-text.data-v-dccd4508 {
	font-size: 28rpx;
	color: #666;
}
.type-tab.active .type-tab-text.data-v-dccd4508 {
	color: #ffffff;
	font-weight: 600;
}

/* 主内容区 */
.content-container.data-v-dccd4508 {
	flex: 1;
	display: flex;
	overflow: hidden;
}

/* 左侧学科门类 */
.category-list.data-v-dccd4508 {
	width: 180rpx;
	background: #f8f9fa;
	flex-shrink: 0;
}
.category-item.data-v-dccd4508 {
	padding: 32rpx 20rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	position: relative;
}
.category-item.active.data-v-dccd4508 {
	background: #ffffff;
}
.category-item.active.data-v-dccd4508::before {
	content: '';
	position: absolute;
	left: 0;
	top: 50%;
	transform: translateY(-50%);
	width: 6rpx;
	height: 40rpx;
	background: #5b8ff9;
	border-radius: 0 4rpx 4rpx 0;
}
.category-text.data-v-dccd4508 {
	font-size: 26rpx;
	color: #666;
}
.category-item.active .category-text.data-v-dccd4508 {
	color: #333;
	font-weight: 600;
}

/* 右侧专业列表 */
.major-list.data-v-dccd4508 {
	flex: 1;
	background: #ffffff;
	padding: 20rpx 0;
}
.discipline-group.data-v-dccd4508 {
	border-bottom: 1rpx solid #f0f0f0;
}
.discipline-header.data-v-dccd4508 {
	padding: 24rpx 30rpx;
	display: flex;
	align-items: center;
	justify-content: space-between;
}
.discipline-name.data-v-dccd4508 {
	font-size: 28rpx;
	color: #333;
	font-weight: 500;
}
.discipline-arrow.data-v-dccd4508 {
	font-size: 24rpx;
	color: #999;
}
.major-items.data-v-dccd4508 {
	background: #f8f9fa;
}
.major-item.data-v-dccd4508 {
	padding: 24rpx 30rpx;
	padding-left: 50rpx;
	border-bottom: 1rpx solid #f0f0f0;
}
.major-item.data-v-dccd4508:last-child {
	border-bottom: none;
}
.major-text.data-v-dccd4508 {
	font-size: 26rpx;
	color: #666;
}

/* 加载状态 */
.loading-text.data-v-dccd4508 {
	text-align: center;
	padding: 32rpx 0;
	font-size: 26rpx;
	color: #999;
}
.empty-text.data-v-dccd4508 {
	text-align: center;
	padding: 60rpx 0;
	font-size: 26rpx;
	color: #999;
}
