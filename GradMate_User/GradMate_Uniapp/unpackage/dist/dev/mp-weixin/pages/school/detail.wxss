}
.more-text.data-v-6b1a9528 {
	font-size: 26rpx;
	color: #5b8ff9;
}

/* 空状态 */
.empty-hint.data-v-6b1a9528 {
	text-align: center;
	padding: 60rpx 0;
}
.empty-text.data-v-6b1a9528 {
