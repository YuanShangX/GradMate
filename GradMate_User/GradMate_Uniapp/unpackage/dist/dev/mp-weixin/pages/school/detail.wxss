
.page.data-v-6b1a9528 {
	min-height: 100vh;
	background: #f0f3fa;
}

/* 白色导航栏 */
.navbar.data-v-6b1a9528 {
	background: #ffffff;
	padding: 20rpx 30rpx;
	padding-top: calc(20rpx + env(safe-area-inset-top));
	display: flex;
	align-items: center;
	justify-content: center;
	position: relative;
	box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.nav-back.data-v-6b1a9528 {
	position: absolute;
	left: 30rpx;
	top: 50%;
	transform: translateY(-50%);
	width: 48rpx;
	height: 48rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}
.back-icon.data-v-6b1a9528 {
	font-size: 56rpx;
	color: #333;
	font-weight: 300;
	line-height: 1;
}
.nav-title.data-v-6b1a9528 {
	font-size: 36rpx;
	font-weight: 700;
	color: #333;
}

/* 内容区 */
.content.data-v-6b1a9528 {
	height: calc(100vh - 88rpx - env(safe-area-inset-top));
	padding: 20rpx 30rpx 40rpx;
	box-sizing: border-box;
}

/* 学校信息卡片 */
.school-card.data-v-6b1a9528 {
	background: linear-gradient(180deg, #e8f4ff 0%, #f5f9ff 100%);
	border-radius: 20rpx;
	padding: 40rpx 32rpx;
	margin-bottom: 20rpx;
	display: flex;
	flex-direction: column;
	align-items: center;
	position: relative;
	box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* logo容器 */
.logo-container.data-v-6b1a9528 {
	width: 140rpx;
	height: 140rpx;
	border-radius: 50%;
	background: #ffffff;
	display: flex;
	align-items: center;
	justify-content: center;
	box-shadow: 0 4rpx 16rpx rgba(91, 143, 249, 0.15);
	margin-bottom: 24rpx;
	overflow: hidden;
}
.school-logo.data-v-6b1a9528 {
	width: 100%;
	height: 100%;
	border-radius: 50%;
}
.logo-placeholder.data-v-6b1a9528 {
	width: 90rpx;
	height: 90rpx;
	border-radius: 50%;
	background: linear-gradient(135deg, #5b8ff9 0%, #378cff 100%);
}

/* 学校名称 */
.school-name.data-v-6b1a9528 {
	font-size: 40rpx;
	font-weight: 700;
	color: #333;
	text-align: center;
	margin-bottom: 20rpx;
}

/* 地区和隶属信息 */
.school-meta.data-v-6b1a9528 {
	display: flex;
	align-items: center;
	gap: 16rpx;
	margin-bottom: 24rpx;
}
.meta-item.data-v-6b1a9528 {
	display: flex;
	align-items: center;
	gap: 8rpx;
}
.meta-icon.data-v-6b1a9528 {
	font-size: 24rpx;
}
.meta-text.data-v-6b1a9528 {
	font-size: 24rpx;
	color: #666;
}
.meta-divider.data-v-6b1a9528 {
	font-size: 24rpx;
	color: #ddd;
}

/* 标签 */
.school-tags.data-v-6b1a9528 {
	display: flex;
	gap: 16rpx;
	flex-wrap: wrap;
	justify-content: center;
}
.tag.data-v-6b1a9528 {
	background: rgba(91, 143, 249, 0.1);
	color: #5b8ff9;
	font-size: 22rpx;
	padding: 6rpx 18rpx;
	border-radius: 20rpx;
	font-weight: 500;
}

/* 关注按钮 */
.follow-button.data-v-6b1a9528 {
	position: absolute;
	right: 32rpx;
	top: 32rpx;
	background: #1b7dff;
	border-radius: 48rpx;
	padding: 14rpx 28rpx;
	display: flex;
	align-items: center;
	gap: 8rpx;
	box-shadow: 0 4rpx 12rpx rgba(27, 125, 255, 0.3);
}
.follow-icon.data-v-6b1a9528 {
	font-size: 24rpx;
	color: #ffffff;
}
.follow-text.data-v-6b1a9528 {
	font-size: 26rpx;
	color: #ffffff;
	font-weight: 500;
}

/* 功能按钮卡片 */
.function-card.data-v-6b1a9528 {
	background: #ffffff;
	border-radius: 20rpx;
	padding: 32rpx;
	margin-bottom: 20rpx;
	box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 功能按钮组 */
.action-buttons.data-v-6b1a9528 {
	display: flex;
	justify-content: space-around;
}
.action-item.data-v-6b1a9528 {
	display: flex;
	align-items: center;
	justify-content: center;
}
.action-text.data-v-6b1a9528 {
	font-size: 26rpx;
	color: #999;
	font-weight: 400;
}

/* 加载状态 */
.loading-container.data-v-6b1a9528 {
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 120rpx 0;
}
.loading-text.data-v-6b1a9528 {
	font-size: 28rpx;
	color: #999;
}

/* 信息卡片 */
.info-card.data-v-6b1a9528 {
	background: #ffffff;
	border-radius: 20rpx;
	padding: 32rpx;
	margin-bottom: 20rpx;
	box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 卡片标题 */
.card-title.data-v-6b1a9528 {
	display: flex;
	align-items: center;
	gap: 12rpx;
	margin-bottom: 24rpx;
}
.title-bar.data-v-6b1a9528 {
	width: 6rpx;
	height: 32rpx;
	background: #5b8ff9;
	border-radius: 3rpx;
}
.title-text.data-v-6b1a9528 {
	font-size: 32rpx;
	font-weight: 600;
	color: #333;
}

/* 招生办网址按钮 */
.website-btn.data-v-6b1a9528 {
	display: flex;
	align-items: center;
	padding: 24rpx;
	background: #f8f9ff;
	border-radius: 12rpx;
	gap: 16rpx;
}
.website-icon.data-v-6b1a9528 {
	font-size: 32rpx;
}
.website-text.data-v-6b1a9528 {
	flex: 1;
	font-size: 28rpx;
	color: #333;
}
.website-arrow.data-v-6b1a9528 {
	font-size: 32rpx;
	color: #ccc;
}

/* 专业列表 */
.major-list.data-v-6b1a9528 {
	display: flex;
	flex-direction: column;
}
.major-item.data-v-6b1a9528 {
	display: flex;
	align-items: center;
	padding: 24rpx 0;
	border-bottom: 1rpx solid #f0f0f0;
}
.major-item.data-v-6b1a9528:last-child {
	border-bottom: none;
}
.major-code.data-v-6b1a9528 {
	font-size: 26rpx;
	color: #5b8ff9;
	width: 140rpx;
	flex-shrink: 0;
}
.major-name.data-v-6b1a9528 {
	font-size: 26rpx;
	color: #333;
	flex: 1;
}
.major-arrow.data-v-6b1a9528 {
	font-size: 32rpx;
	color: #ccc;
}

/* 资讯列表 */
.info-list.data-v-6b1a9528 {
	display: flex;
	flex-direction: column;
}
.info-item.data-v-6b1a9528 {
	padding: 24rpx 0;
	border-bottom: 1rpx solid #f0f0f0;
}
.info-item.data-v-6b1a9528:last-child {
	border-bottom: none;
}
.info-title.data-v-6b1a9528 {
	font-size: 28rpx;
	color: #333;
	line-height: 1.6;
	display: block;
