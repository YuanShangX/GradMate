
.page.data-v-a7d40b14 {
	min-height: 100vh;
	background: linear-gradient(180deg, #e8f4ff 0%, #f5f9ff 100%);
	display: flex;
	flex-direction: column;
}

/* 导航栏 */
.navbar.data-v-a7d40b14 {
	padding: 20rpx 30rpx;
	padding-top: calc(20rpx + env(safe-area-inset-top));
}
.nav-back.data-v-a7d40b14 {
	width: 48rpx;
	height: 48rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}
.back-icon.data-v-a7d40b14 {
	font-size: 40rpx;
	color: #333;
}

/* 进度条 */
.progress-bar.data-v-a7d40b14 {
	display: flex;
	justify-content: space-around;
	padding: 20rpx 30rpx;
	background: rgba(255, 255, 255, 0.8);
	margin: 0 40rpx 20rpx;
	border-radius: 16rpx;
}
.progress-item.data-v-a7d40b14 {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 8rpx;
	flex: 1;
}
.progress-dot.data-v-a7d40b14 {
	width: 16rpx;
	height: 16rpx;
	border-radius: 50%;
	background: #ddd;
}
.progress-item.active .progress-dot.data-v-a7d40b14 {
	background: #5b8ff9;
}
.progress-text.data-v-a7d40b14 {
	font-size: 20rpx;
	color: #999;
	text-align: center;
}
.progress-item.active .progress-text.data-v-a7d40b14 {
	color: #5b8ff9;
	font-weight: 500;
}

/* AI头像 */
.ai-header.data-v-a7d40b14 {
	display: flex;
	align-items: center;
	gap: 20rpx;
	padding: 0 30rpx 20rpx;
}
.ai-avatar.data-v-a7d40b14 {
	width: 80rpx;
	height: 80rpx;
	border-radius: 50%;
	background: #ffffff;
	display: flex;
	align-items: center;
	justify-content: center;
	box-shadow: 0 4rpx 12rpx rgba(91, 143, 249, 0.2);
	position: relative;
}
.robot-icon.data-v-a7d40b14 {
	width: 40rpx;
	height: 40rpx;
	background: linear-gradient(135deg, #5b8ff9 0%, #378cff 100%);
	border-radius: 8rpx;
	position: relative;
}
.robot-icon.data-v-a7d40b14::before {
	content: '';
	position: absolute;
	width: 12rpx;
	height: 12rpx;
	background: #ffffff;
	border-radius: 50%;
	top: 10rpx;
	left: 8rpx;
}
.robot-icon.data-v-a7d40b14::after {
	content: '';
	position: absolute;
	width: 12rpx;
	height: 12rpx;
	background: #ffffff;
	border-radius: 50%;
	top: 10rpx;
	right: 8rpx;
}
.ai-info.data-v-a7d40b14 {
	display: flex;
	flex-direction: column;
	gap: 4rpx;
}
.ai-name.data-v-a7d40b14 {
	font-size: 32rpx;
	font-weight: 600;
	color: #333;
}
.ai-desc.data-v-a7d40b14 {
	font-size: 24rpx;
	color: #999;
}

/* 聊天容器 */
.chat-container.data-v-a7d40b14 {
	flex: 1;
	padding: 20rpx 30rpx;
	padding-right: 30rpx;
	box-sizing: border-box;
}
.message-item.data-v-a7d40b14 {
	margin-bottom: 24rpx;
	box-sizing: border-box;
	animation: fadeInUp-a7d40b14 0.4s ease-out;
}
@keyframes fadeInUp-a7d40b14 {
from {
		opacity: 0;
		transform: translateY(20rpx);
}
to {
		opacity: 1;
		transform: translateY(0);
}
}
.ai-message.data-v-a7d40b14 {
	background: #ffffff;
	border-radius: 16rpx;
	padding: 24rpx;
	box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
	box-sizing: border-box;
	max-width: 100%;
	word-wrap: break-word;
	animation: slideInLeft-a7d40b14 0.3s ease-out;
}
@keyframes slideInLeft-a7d40b14 {
from {
		opacity: 0;
		transform: translateX(-30rpx);
}
to {
		opacity: 1;
		transform: translateX(0);
}
}
.user-message-bubble.data-v-a7d40b14 {
	background: #5b8ff9;
	border-radius: 16rpx;
	padding: 24rpx;
	margin-left: 100rpx;
	box-sizing: border-box;
	max-width: calc(100% - 100rpx);
	word-wrap: break-word;
	animation: slideInRight-a7d40b14 0.3s ease-out;
}
@keyframes slideInRight-a7d40b14 {
from {
		opacity: 0;
		transform: translateX(30rpx);
}
to {
		opacity: 1;
		transform: translateX(0);
}
}
.user-message-bubble .message-text.data-v-a7d40b14 {
	color: #ffffff;
}
.message-text.data-v-a7d40b14 {
	font-size: 28rpx;
	color: #333;
	line-height: 1.6;
	white-space: pre-wrap;
	animation: typing-a7d40b14 0.5s steps(40) forwards;
}
@keyframes typing-a7d40b14 {
from {
		opacity: 0;
}
to {
		opacity: 1;
}
}
.loading-message.data-v-a7d40b14 {
	text-align: center;
	padding: 20rpx 0;
}
.loading-text.data-v-a7d40b14 {
	font-size: 26rpx;
	color: #999;
}

/* 输入区域 */
.input-container.data-v-a7d40b14 {
	background: #ffffff;
	padding: 20rpx 30rpx;
	padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
	display: flex;
	gap: 16rpx;
	box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.05);
}
.input-box.data-v-a7d40b14 {
	flex: 1;
	background: #f5f5f5;
	border-radius: 24rpx;
	padding: 16rpx 24rpx;
	font-size: 28rpx;
}
.send-btn.data-v-a7d40b14 {
	background: #5b8ff9;
	border-radius: 24rpx;
	padding: 16rpx 32rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}
.send-text.data-v-a7d40b14 {
	font-size: 28rpx;
	color: #ffffff;
	font-weight: 500;
}
