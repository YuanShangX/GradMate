
.page.data-v-e4e4508d {
	min-height: 100vh;
	background: #006cff;
}
.status-bar.data-v-e4e4508d {
	background: #006cff;
}

/* 蓝色顶部区域 */
.header-section.data-v-e4e4508d {
	background: #006cff;
	padding: 60rpx 30rpx 100rpx;
}
.header-content.data-v-e4e4508d {
	text-align: center;
}
.logo.data-v-e4e4508d {
	width: 140rpx;
	height: 140rpx;
	margin-bottom: 32rpx;
	border-radius: 70rpx;
	box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}
.title.data-v-e4e4508d {
	display: block;
	font-size: 48rpx;
	font-weight: bold;
	color: #ffffff;
	margin-bottom: 16rpx;
}
.subtitle.data-v-e4e4508d {
	display: block;
	font-size: 26rpx;
	color: rgba(255, 255, 255, 0.85);
}

/* 白色内容区 */
.content-section.data-v-e4e4508d {
	background: linear-gradient(180deg, #e8f3ff 0%, #f6f7fb 15%, #f6f7fb 100%);
	border-radius: 32rpx 32rpx 0 0;
	margin-top: -32rpx;
	padding: 32rpx 30rpx 60rpx;
	min-height: calc(100vh - 400rpx);
}

/* Tab切换 */
.tab-bar.data-v-e4e4508d {
	display: flex;
	background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
	border-radius: 50rpx;
	padding: 8rpx;
	margin-bottom: 32rpx;
	box-shadow: 0 4rpx 12rpx rgba(0, 107, 255, 0.08);
	border: 1rpx solid rgba(0, 107, 255, 0.05);
}
.tab-item.data-v-e4e4508d {
	flex: 1;
	text-align: center;
	padding: 20rpx 0;
	border-radius: 44rpx;
	transition: all 0.3s ease;
}
.tab-item.active.data-v-e4e4508d {
	background: linear-gradient(135deg, #378cff 0%, #1b7dff 100%);
	box-shadow: 0 4rpx 12rpx rgba(0, 107, 255, 0.25);
}
.tab-text.data-v-e4e4508d {
	font-size: 28rpx;
	color: #666;
	font-weight: 500;
}
.tab-item.active .tab-text.data-v-e4e4508d {
	color: #ffffff;
	font-weight: 600;
}

/* 表单容器 */
.form-container.data-v-e4e4508d {
	padding-top: 8rpx;
}
.form-card.data-v-e4e4508d {
	background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
	border-radius: 16rpx;
	padding: 16rpx 24rpx;
	margin-bottom: 32rpx;
	box-shadow: 0 4rpx 12rpx rgba(0, 107, 255, 0.08);
	border: 1rpx solid rgba(0, 107, 255, 0.05);
}
.form-item.data-v-e4e4508d {
	margin-bottom: 24rpx;
}
.form-item.data-v-e4e4508d:last-child {
	margin-bottom: 0;
}
.input-wrapper.data-v-e4e4508d {
	display: flex;
	align-items: center;
	background: linear-gradient(135deg, #f0f8ff 0%, #e8f3ff 100%);
	border-radius: 50rpx;
	padding: 0 24rpx;
	border: 2rpx solid rgba(0, 107, 255, 0.1);
	transition: all 0.3s ease;
}
.input-wrapper.data-v-e4e4508d:focus-within {
	border-color: #006cff;
	background: #ffffff;
	box-shadow: 0 2rpx 8rpx rgba(0, 107, 255, 0.15);
}
.input-icon.data-v-e4e4508d {
	width: 36rpx;
	height: 36rpx;
	margin-right: 16rpx;
	flex-shrink: 0;
	position: relative;
}
.user-icon.data-v-e4e4508d {
	background: linear-gradient(135deg, #378cff 0%, #1b7dff 100%);
	border-radius: 50%;
}
.user-icon.data-v-e4e4508d::before {
	content: '';
	position: absolute;
	width: 14rpx;
	height: 14rpx;
	background: rgba(255, 255, 255, 0.9);
	border-radius: 50%;
	top: 8rpx;
	left: 11rpx;
}
.user-icon.data-v-e4e4508d::after {
	content: '';
	position: absolute;
	width: 20rpx;
	height: 10rpx;
	background: rgba(255, 255, 255, 0.9);
	border-radius: 0 0 10rpx 10rpx;
	bottom: 6rpx;
	left: 8rpx;
}
.lock-icon.data-v-e4e4508d {
	background: linear-gradient(135deg, #ffb84d 0%, #ff9500 100%);
	border-radius: 8rpx;
}
.lock-icon.data-v-e4e4508d::before {
	content: '';
	position: absolute;
	width: 18rpx;
	height: 14rpx;
	border: 3rpx solid rgba(255, 255, 255, 0.9);
	border-bottom: none;
	border-radius: 9rpx 9rpx 0 0;
	top: 6rpx;
	left: 9rpx;
}
.lock-icon.data-v-e4e4508d::after {
	content: '';
	position: absolute;
	width: 20rpx;
	height: 12rpx;
	background: rgba(255, 255, 255, 0.9);
	border-radius: 3rpx;
	bottom: 8rpx;
	left: 8rpx;
}
.nickname-icon.data-v-e4e4508d {
	background: linear-gradient(135deg, #a78bfa 0%, #8b5cf6 100%);
	border-radius: 50%;
}
.nickname-icon.data-v-e4e4508d::before {
	content: '';
	position: absolute;
	width: 0;
	height: 0;
	border-left: 8rpx solid transparent;
	border-right: 8rpx solid transparent;
	border-bottom: 12rpx solid rgba(255, 255, 255, 0.9);
	top: 8rpx;
	left: 10rpx;
}
.nickname-icon.data-v-e4e4508d::after {
	content: '';
	position: absolute;
	width: 0;
	height: 0;
	border-left: 8rpx solid transparent;
	border-right: 8rpx solid transparent;
	border-top: 12rpx solid rgba(255, 255, 255, 0.9);
	bottom: 8rpx;
	left: 10rpx;
}
.input.data-v-e4e4508d {
	flex: 1;
	height: 80rpx;
	font-size: 28rpx;
	color: #333;
}
.input.data-v-e4e4508d::-webkit-input-placeholder {
	color: #999;
}
.input.data-v-e4e4508d::placeholder {
	color: #999;
}

/* 提交按钮 */
.submit-btn.data-v-e4e4508d {
	width: 100%;
	height: 88rpx;
	background: linear-gradient(135deg, #378cff 0%, #1b7dff 100%);
	color: #ffffff;
	border: none;
	border-radius: 44rpx;
	font-size: 32rpx;
	font-weight: 600;
	box-shadow: 0 8rpx 20rpx rgba(0, 107, 255, 0.3);
	transition: all 0.3s ease;
}
.submit-btn.data-v-e4e4508d:active {
	opacity: 0.9;
	transform: scale(0.98);
}
.submit-btn.data-v-e4e4508d:disabled {
	background: linear-gradient(135deg, #e0e0e0 0%, #d0d0d0 100%);
	color: #999;
	box-shadow: none;
}
